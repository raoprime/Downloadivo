{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/health"
    },
    {
      "source": "/system-info",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/system-info"
    },
    {
      "source": "/info",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/info"
    },
    {
      "source": "/download",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/download"
    },
    {
      "source": "/status/:path*",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/status/:path*"
    },
    {
      "source": "/file/:path*",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/file/:path*"
    },
    {
      "source": "/download-file/:path*",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/download-file/:path*"
    },
    {
      "source": "/open-file",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/open-file"
    },
    {
      "source": "/open-folder",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/open-folder"
    },
    {
      "source": "/stream",
      "destination": "https://satellite-every-exhibition-cart.trycloudflare.com/stream"
    }
  ]
}
