{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/health"
    },
    {
      "source": "/system-info",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/system-info"
    },
    {
      "source": "/info",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/info"
    },
    {
      "source": "/download",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/download"
    },
    {
      "source": "/status/:path*",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/status/:path*"
    },
    {
      "source": "/file/:path*",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/file/:path*"
    },
    {
      "source": "/download-file/:path*",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/download-file/:path*"
    },
    {
      "source": "/open-file",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/open-file"
    },
    {
      "source": "/open-folder",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/open-folder"
    },
    {
      "source": "/stream",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/stream"
    },
    {
      "source": "/downloads",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/downloads"
    },
    {
      "source": "/cancel/:path*",
      "destination": "https://iii-basketball-focus-titles.trycloudflare.com/cancel/:path*"
    }
  ]
}
